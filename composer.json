{
  "name": "elyerr/api-response",
  "description": "Add news functionalities for oauth2 passport server",
  "type": "library",
  "version": "v2.0.0",
  "license": "AGPL-3.0-only",
  "extra": {
    "laravel": {
      "providers": [
        "Elyerr\\ApiResponse\\ServiceProvider"
      ]
    }
  },
  "autoload": {
    "psr-4": {
      "Elyerr\\ApiResponse\\": "src/"
    },
    "files": [
      "src/Support/helper.php"
    ]
  },
  "authors": [
    {
      "name": "Elvis Yerel Roman Concha",
      "email": "yerel9212@yahoo.es",
      "role": "owner",
      "homepage": "https://github.com/elyerrlabs"
    }
  ],
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "spatie/laravel-fractal": "^6.4"
  },
  "require-dev": {
    "php": "^8.2.0",
    "laravel/framework": "^12.0"
  }
}
